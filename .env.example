# WhatsApp AI Assistant Configuration
# Copy this file to .env and fill in your values

# Required: Admin phone number in E.164 format (e.g., +1234567890)
ADMIN_PHONE=+1234567890

# Optional: Additional admin phone numbers (comma-separated, E.164 format)
ADDITIONAL_ADMIN_PHONES=+1234567891,+1234567892

# AI Gateway URL (should point to your pi-ai-gateway instance)
# Use DNS name if running in Docker network with nginx
GATEWAY_BASE_URL=http://ai-gateway.local

# Database path (inside container)
DB_PATH=/app/data/whatsapp-ai.db

# Node.js environment
NODE_ENV=production

# Spring profile
SPRING_PROFILES_ACTIVE=production
